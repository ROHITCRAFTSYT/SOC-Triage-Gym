# Python artifacts
__pycache__/
*.py[cod]
*$py.class
*.pyc
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
dist/
build/
.eggs/

# Development tools
.git/
.gitignore
.venv/
venv/
env/
.env
.env.*

# IDE files
.vscode/
.idea/
*.swp
*.swo

# Documentation extras
*.md
!README.md
!blog.md

# Test artifacts
tests/
*.test.py

# OS artifacts
.DS_Store
Thumbs.db

# Logs
*.log
logs/

# Heavy assets the server never reads (README charts, slide PDFs, notebooks,
# the static microsite, committed training/benchmark outputs). Keeps the build
# context small and avoids shipping Git LFS pointer files into the image.
*.png
*.pdf
*.ipynb
*.csv
site/
assets/
benchmarks/
uv.lock
